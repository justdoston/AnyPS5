foreach(variable TOP OUT JIMSH LEMON KEYWORDHASH SOURCEID)
    if(NOT DEFINED ${variable})
        message(FATAL_ERROR "SqliteAmalgamation.cmake: ${variable} is not set")
    endif()
endforeach()

function(sqlite_run)
    cmake_parse_arguments(RUN "" "INPUT;OUTPUT" "COMMAND" ${ARGN})
    set(redirect)
    if(RUN_INPUT)
        list(APPEND redirect INPUT_FILE ${RUN_INPUT})
    endif()
    if(RUN_OUTPUT)
        list(APPEND redirect OUTPUT_FILE ${RUN_OUTPUT})
    endif()
    execute_process(COMMAND ${RUN_COMMAND} WORKING_DIRECTORY ${OUT} RESULT_VARIABLE result ${redirect})
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "SqliteAmalgamation.cmake: ${RUN_COMMAND} failed: ${result}")
    endif()
endfunction()

file(REMOVE_RECURSE ${OUT}/tsrc)
file(MAKE_DIRECTORY ${OUT}/tsrc)
get_filename_component(sourceIdExtension ${SOURCEID} LAST_EXT)
file(COPY_FILE ${SOURCEID} ${OUT}/mksourceid${sourceIdExtension})

file(COPY_FILE ${TOP}/tool/lempar.c ${OUT}/lempar.c)
file(COPY_FILE ${TOP}/src/parse.y ${OUT}/parse.y)
sqlite_run(COMMAND ${LEMON} -S parse.y)
file(COPY_FILE ${TOP}/ext/fts5/fts5parse.y ${OUT}/fts5parse.y)
file(REMOVE ${OUT}/fts5parse.h)
sqlite_run(COMMAND ${LEMON} -S fts5parse.y)

file(READ ${OUT}/parse.h parseHeader)
file(READ ${TOP}/src/vdbe.c vdbeSource)
file(WRITE ${OUT}/opcodes.in "${parseHeader}${vdbeSource}")
sqlite_run(COMMAND ${JIMSH} ${TOP}/tool/mkopcodeh.tcl INPUT ${OUT}/opcodes.in OUTPUT ${OUT}/opcodes.h)
sqlite_run(COMMAND ${JIMSH} ${TOP}/tool/mkopcodec.tcl opcodes.h OUTPUT ${OUT}/opcodes.c)
sqlite_run(COMMAND ${KEYWORDHASH} OUTPUT ${OUT}/keywordhash.h)
sqlite_run(COMMAND ${JIMSH} ${TOP}/tool/mkpragmatab.tcl)
sqlite_run(COMMAND ${JIMSH} ${TOP}/tool/mkctimec.tcl)
sqlite_run(COMMAND ${JIMSH} ${TOP}/ext/fts5/tool/mkfts5c.tcl)
file(COPY_FILE ${TOP}/ext/fts5/fts5.h ${OUT}/fts5.h)
sqlite_run(COMMAND ${JIMSH} ${TOP}/tool/mksqlite3h.tcl ${TOP} -o sqlite3.h)

file(READ ${TOP}/main.mk makefile)
string(REPLACE "\\\n" " " makefile "${makefile}")
string(REGEX MATCHALL "\nSRC \\+?=[^\n]*" assignments "\n${makefile}")
set(sources)
foreach(assignment IN LISTS assignments)
    string(REGEX REPLACE "^\nSRC \\+?=" "" assignment "${assignment}")
    string(REGEX REPLACE "[ \t]+" ";" assignment "${assignment}")
    list(APPEND sources ${assignment})
endforeach()
list(REMOVE_ITEM sources "")
set(skipped tclsqlite-ex.c sqlite_cfg.h shell.c)
foreach(source IN LISTS sources)
    if(source MATCHES "^\\$\\(TOP\\)/(.*)$")
        file(COPY ${TOP}/${CMAKE_MATCH_1} DESTINATION ${OUT}/tsrc)
    elseif(NOT source IN_LIST skipped)
        file(COPY ${OUT}/${source} DESTINATION ${OUT}/tsrc)
    endif()
endforeach()
file(REMOVE ${OUT}/tsrc/sqlite.h.in ${OUT}/tsrc/parse.y)
sqlite_run(COMMAND ${JIMSH} ${TOP}/tool/vdbe-compress.tcl INPUT ${OUT}/tsrc/vdbe.c OUTPUT ${OUT}/vdbe.new)
file(RENAME ${OUT}/vdbe.new ${OUT}/tsrc/vdbe.c)
file(COPY ${OUT}/fts5.c ${OUT}/fts5.h DESTINATION ${OUT}/tsrc)
sqlite_run(COMMAND ${JIMSH} ${TOP}/tool/mksqlite3c.tcl)
